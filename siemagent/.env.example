# LLM provider — Gemini (used when GEMINI_API_KEY is set)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SIEM_MODEL=gemini-2.5-flash

# Fallback provider — Kimchi or any OpenAI-compatible endpoint (used when GEMINI_API_KEY is empty)
# KIMCHI_API_KEY=your_kimchi_api_key_here
# KIMCHI_BASE_URL=https://api.kimchi.ai/v1
# SIEM_MODEL=kimi-k2-5

# Server
CONDUCTOR_PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Vector DB
QDRANT_ADDR=localhost:6334

# PostgreSQL (Phase 3)
POSTGRES_DSN=postgres://siemagent:siemagent@localhost:5432/siemagent?sslmode=disable

# Embeddings
OLLAMA_URL=http://localhost:11434
