# ── LLM provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER picks the model backend: gemini | ollama | openai.
# Leave it empty to auto-detect: Gemini when GEMINI_API_KEY is set,
# otherwise the OpenAI-compatible endpoint below.
# LLM_PROVIDER=

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.8-flash

# Ollama — fully local, no key, logs never leave this machine.
# Set LLM_PROVIDER=ollama and pull the model first: ollama pull llama3.2
# OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint (Kimchi, OpenAI, Groq, vLLM…)
# KIMCHI_API_KEY=your_api_key_here
# KIMCHI_BASE_URL=https://api.kimchi.ai/v1
# SIEM_MODEL=kimi-k2-5

# ── Server ────────────────────────────────────────────────────────────────────
CONDUCTOR_PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Comma-separated API keys. When set, /api, /ws, /metrics and /classify
# require "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Leave empty only for local development. For the dashboard, put the same key
# in web/.env.local as VITE_SIEM_API_KEY=<key>.
# SIEM_API_KEYS=

# ── Storage ───────────────────────────────────────────────────────────────────
# Event history. docker-compose publishes Postgres on 5433. If set but
# unreachable the server refuses to start; leave empty to keep events in
# memory only (lost on restart).
POSTGRES_DSN=postgres://siemagent:siemagent@localhost:5433/siemagent?sslmode=disable

# Vector search (semantic "similar events")
QDRANT_ADDR=localhost:6334

# Embeddings for vector search, and chat when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# ── Log ingestion ─────────────────────────────────────────────────────────────
# Receive syslog from rsyslog / syslog-ng / network devices. Ports below 1024
# (like 514) need root, so forward 514 to these if your senders need it.
# SYSLOG_UDP_ADDR=:5514
# SYSLOG_TCP_ADDR=:5514

# ── Detection rules ───────────────────────────────────────────────────────────
# rules-first: a Sigma rule match classifies the event with no LLM call (default)
# enrich:      always ask the LLM, attach matching rules
# off:         no rules. See docs/DETECTION.md.
# DETECTION_MODE=rules-first
# Extra Sigma rules (searched recursively), e.g. a SigmaHQ checkout:
# SIGMA_RULES_DIR=/opt/sigma/rules/linux

# ── Incidents ─────────────────────────────────────────────────────────────────
# Alerts sharing an IP, user or host within this window join one incident.
# INCIDENT_WINDOW=1h
# Least severe alert that opens or joins an incident (P4/P5 stay events only).
# INCIDENT_MIN_SEVERITY=P3

# ── Response playbooks ───────────────────────────────────────────────────────
# Playbooks propose actions; analysts approve them. See docs/RESPONSE.md.
# Extra playbooks (.yml), searched recursively:
# PLAYBOOKS_DIR=/etc/siemagent/playbooks
# Receives approved block_ip / disable_user / isolate_host actions as JSON.
# Point it at your automation (n8n, Tines, Shuffle, AWX, a Lambda…):
# RESPONSE_WEBHOOK_URL=https://automation.example.com/hooks/siemagent
# Slack incoming webhook for notify actions (contains a secret token):
# SLACK_WEBHOOK_URL=

# ── Threat intel (optional, used by the investigation agent) ─────────────────
# ABUSEIPDB_KEY=
# OTX_API_KEY=
